<% layout('/layouts/boilerplate.ejs') %>

<div class="container mt-5 mb-5">

  <!-- LISTING DETAILS -->
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <h2 class="mb-4"><%= listing.title %></h2>

      <div class="card shadow-sm border-0">

        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          style="height: 450px; object-fit: cover"
          alt="<%= listing.title %>"
        />

        <div class="card-body">

          <!-- OWNER -->
          <p>
            <strong>Owned by:</strong>
            <%= listing.owner && listing.owner.username %>
          </p>

          <!-- DESCRIPTION -->
          <p>
            <strong>Description:</strong><br />
            <%= listing.description %>
          </p>

          <!-- PRICE -->
          <h4 class="text-success">
            &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
          </h4>

          <!-- LOCATION -->
          <p class="mt-3 mb-1">
            <strong>Location:</strong>
            <%= listing.location %>
          </p>

          <!-- COUNTRY -->
          <p>
            <strong>Country:</strong>
            <%= listing.country %>
          </p>

          <!-- EDIT / DELETE -->
          <% if (currUser && listing.owner &&
                currUser._id.equals(listing.owner._id)) { %>

            <div class="d-flex gap-3 mt-4">

              <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-warning"
              >
                Edit
              </a>

              <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
              >
                <button class="btn btn-danger">
                  Delete
                </button>
              </form>

            </div>

          <% } %>

        </div>
      </div>

    </div>
  </div>

 

  <!-- REVIEW SECTION -->
  <% if (currUser) { %>

    <div class="col-8 offset-3 mb-3">

      <h4>Leave a Review</h4>

      <form
        method="POST"
        action="/listings/<%= listing._id %>/reviews"
        novalidate
        class="needs-validation"
      >

        <!-- RATING -->
        <div class="mb-3 mt-3">

          <label for="rating" class="form-label">
            Rating
          </label>

          <fieldset class="starability-heartbeat">

            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />

            <input
              type="radio"
              id="first-rate1"
              name="review[rating]"
              value="1"
            />

            <label for="first-rate1" title="Terrible">
              1 star
            </label>

            <input
              type="radio"
              id="first-rate2"
              name="review[rating]"
              value="2"
            />

            <label for="first-rate2" title="Not good">
              2 stars
            </label>

            <input
              type="radio"
              id="first-rate3"
              name="review[rating]"
              value="3"
            />

            <label for="first-rate3" title="Average">
              3 stars
            </label>

            <input
              type="radio"
              id="first-rate4"
              name="review[rating]"
              value="4"
            />

            <label for="first-rate4" title="Very good">
              4 stars
            </label>

            <input
              type="radio"
              id="first-rate5"
              name="review[rating]"
              value="5"
            />

            <label for="first-rate5" title="Amazing">
              5 stars
            </label>

          </fieldset>

        </div>

        <!-- COMMENT -->
        <div class="mb-3 mt-3">

          <label for="comment" class="form-label">
            Comment
          </label>

          <textarea
            name="review[comment]"
            id="comment"
            cols="30"
            rows="5"
            class="form-control"
            required
          ></textarea>

          <div class="invalid-feedback">
            Please Add Some Comments For Review
          </div>

        </div>

        <button class="btn btn-outline-dark">
          Submit
        </button>

      </form>

    </div>

  <% } %>

  <hr />

  <!-- ALL REVIEWS -->

  <h4>All Reviews</h4>

  <div class="row">

    <% for (review of listing.reviews) { %>

      <div class="card col-5 ms-2 mb-3">

        <div class="card-body">

          <!-- REVIEW AUTHOR -->
          <h5 class="card-title">
            User:
            @<%= review.author.username %>
          </h5>

          <!-- STAR RATING -->
          <p
            class="starability-result card-text"
            data-rating="<%= review.rating %>"
          ></p>

          <!-- COMMENT -->
          <p class="card-text">
            <strong>Comment:</strong>
            <%= review.comment %>
          </p>

          <!-- DELETE REVIEW -->
          <% if (
            currUser &&
            review.author &&
            currUser._id.equals(review.author._id)
          ) { %>

            <form
              method="POST"
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
            >

              <button class="btn btn-sm btn-dark">
                Delete
              </button>

            </form>

          <% } %>

        </div>

      </div>

    <% } %>

  </div>


  <!-- MAP -->

  <hr />

  <h4 class="mb-3">
    Where you'll be
  </h4>

<div
  id="map"
  // style="height: 400px; width: 90%;"
  data-lat="<%= listing.geometry.coordinates[1] %>"
  data-lng="<%= listing.geometry.coordinates[0] %>"
  data-title="<%= listing.title %>"
></div>

<script src="/js/map.js"></script>

</div>
